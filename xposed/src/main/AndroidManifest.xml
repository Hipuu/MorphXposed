<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The bridge permission is declared by the MorpheXposed app as signature-level. This module
      is signed with the same key, so it is granted it; that is what lets its broadcast reach
      the app's receiver and nothing else's.
    -->
    <uses-permission android:name="dev.morphexposed.permission.BRIDGE" />

    <!--
      LSPosed module metadata, read by LSPosed to list and describe the module.
      The three xposedmodule/xposeddescription/xposedminversion meta-data entries are
      what make LSPosed recognise this APK as a module rather than a plain app.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/module_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="Forwards app install and update events to MorpheXposed so automated patching reacts immediately. Does not modify any app." />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <!-- Tells LSPosed this module targets system_server only. -->
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

        <activity
            android:name=".ModuleInfoActivity"
            android:exported="true"
            android:label="@string/module_name">
            <!-- Launchable from the app drawer for anyone who installed the module directly. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              LSPosed (and classic Xposed) show a "module settings" entry only for a module
              that declares one of these actions. Without them the user is browsing LSPosed
              Manager with no guidance from the module itself, which is exactly where they
              need to know to scope it to System Framework. Both actions are declared because
              LSPosed uses its own and forks still use the original.
            -->
            <intent-filter>
                <action android:name="org.lsposed.manager.action.OPEN_MODULE_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

    </application>

</manifest>
