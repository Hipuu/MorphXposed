<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Package visibility. Morphe patches target specific apps, so the manager must be
      able to see those packages to read their installed version and patch compatibility.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- com.google.android.youtube -->
        <package android:name="com.google.android.youtube" />
        <!-- com.google.android.apps.youtube.music -->
        <package android:name="com.google.android.apps.youtube.music" />
        <!-- com.reddit.frontpage -->
        <package android:name="com.reddit.frontpage" />
    </queries>

    <!--
      Signature-level permission guarding the LSPosed event bridge. Declaring it here means
      only apps signed with this app's key can hold it, which in practice is only the
      MorphXposed Events module.
    -->
    <permission
        android:name="dev.morphxposed.permission.BRIDGE"
        android:protectionLevel="signature" />

    <uses-permission android:name="dev.morphxposed.permission.BRIDGE" />

    <application
        android:name=".MorphXposedApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.MorphXposed">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MorphXposed">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Receives package add/replace/remove so newly installed or updated apps can be
          picked up without waiting for the periodic worker.

          The platform does not deliver PACKAGE_* broadcasts to manifest receivers of ordinary
          apps on Android 8.0+, so the reliable real-time source is the optional LSPosed module.
          It sends dev.morphxposed.LSPOSED_PACKAGE_EVENT, guarded by a signature permission.
          The WorkManager periodic check remains the guaranteed fallback for both.
        -->
        <receiver
            android:name=".automation.PackageChangeReceiver"
            android:exported="true"
            android:permission="dev.morphxposed.permission.BRIDGE">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
            <intent-filter>
                <action android:name="dev.morphxposed.LSPOSED_PACKAGE_EVENT" />
            </intent-filter>
        </receiver>

        <!-- Installer sessions for the standard (non-root) install path. -->
        <receiver
            android:name=".installer.InstallResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.morphxposed.INSTALL_RESULT" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
